  "theorem_id": "primitive-triple-classification-theorem",
  "assertion_identity": {
    "schema_version": 1,
    "object_type": "ASSERTION_IDENTITY",
    "assertion_kind": "PROJECT_THEOREM",
    "stable_id": "primitive-triple-classification-theorem",
    "canonical_statement": "For all positive integers a, b, c, the condition a^2 + b^2 = c^2 and gcd(a,b,c) = 1 holds if and only if, after swapping a and b if necessary, there exist positive integers m > n with gcd(m,n) = 1 and m and n of opposite parity such that a = m^2 - n^2, b = 2mn, and c = m^2 + n^2.",
    "claim_type": "iff",
    "notation_scope": "",
