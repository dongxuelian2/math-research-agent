# Gemini Developer API
GEMINI_API_KEY=

# Official OpenAI Responses API
OPENAI_API_KEY=

# Any OpenAI Responses-compatible server (vLLM, hosted gateway, or local adapter)
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_COMPATIBLE_API_KEY=

# OpenRouter (OpenAI Responses-compatible)
OPENROUTER_API_KEY=

# Codex subscription route: authenticate with `codex login`; no API key is used.

# Optional Vertex Gemini route
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_ACCESS_TOKEN=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional compiler-backed formalization lane
LEAN_PROJECT_DIR=
