{
  "schema_version": 1,
  "description": "Example real configuration using OpenProver's Claude CLI backend. Requires the claude command and its own valid login/subscription.",
  "isolation": true,
  "history_budget": 0,
  "budget": {
    "mode": "time",
    "limit": 14400,
    "conclude_after": 0.99
  },
  "roles": {
    "planner": {
      "provider": "claude_cli",
      "model": "opus",
      "reasoning_effort": "max"
    },
    "worker": {
      "provider": "claude_cli",
      "model": "sonnet",
      "reasoning_effort": "high"
    },
    "cheap_auditor": {
      "provider": "claude_cli",
      "model": "sonnet",
      "reasoning_effort": "medium"
    },
    "final_auditor": {
      "provider": "claude_cli",
      "model": "opus",
      "reasoning_effort": "max"
    }
  }
}

