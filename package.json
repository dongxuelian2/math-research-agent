{
  "name": "math-research-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm run build:proof && pnpm run build:gui",
    "build:proof": "pnpm --filter @math-research-agent/backend run build",
    "build:gui": "pnpm --filter @math-research-agent/proof-workbench run check",
    "typecheck": "pnpm --filter @math-research-agent/backend run typecheck",
    "test:proof": "pnpm --filter @math-research-agent/backend run test",
    "start": "pnpm --dir apps/proof-workbench run serve",
    "start:api": "pnpm --dir apps/proof-workbench run serve -- --api-only"
  }
}
